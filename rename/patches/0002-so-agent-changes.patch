+++ b/bench/interactive.mjs
@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+// Time the interactive TUI start: first output byte, and the moment the screen settles (no output for 300 ms).
+//   node bench/interactive.mjs --cli <cli.js> --prefix SO|PI [--runs 9]
+// A pseudo terminal is provided by util-linux `script`; the child is killed once the screen has settled.
+import { spawn } from "node:child_process";
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const arg = (n, d) => {
+	const i = process.argv.indexOf(`--${n}`);
+	return i >= 0 ? process.argv[i + 1] : d;
+};
+const cli = arg("cli");
+const prefix = arg("prefix", "SO");
+const runs = Number(arg("runs", "9"));
+const home = mkdtempSync(join(tmpdir(), "ibench-home-"));
+const agentDir = join(home, "agent");
+const project = mkdtempSync(join(tmpdir(), "ibench-proj-"));
+mkdirSync(agentDir, { recursive: true });
+writeFileSync(join(agentDir, "settings.json"), JSON.stringify({ quietStartup: false }));
+
+const median = (a) => [...a].sort((x, y) => x - y)[Math.floor(a.length / 2)];
+
+async function once() {
+	const env = {
+		PATH: process.env.PATH,
+		HOME: home,
+		TERM: "xterm-256color",
+		COLUMNS: "100",
+		LINES: "30",
+		[`${prefix}_CODING_AGENT_DIR`]: agentDir,
+		[`${prefix}_OFFLINE`]: "1",
+		[`${prefix}_SKIP_VERSION_CHECK`]: "1",
+		[`${prefix}_TELEMETRY`]: "0",
+	};
+	const t0 = performance.now();
+	const child = spawn("script", ["-qefc", `${process.execPath} ${process.env.BENCH_NODE_ARGS ?? ""} ${cli} --no-extensions --no-session`, "/dev/null"], { cwd: project, env, stdio: ["pipe", "pipe", "pipe"] });
+	let first;
+	let last = 0;
+	let bytes = 0;
+	child.stdout.on("data", (c) => {
+		const now = performance.now() - t0;
+		first ??= now;
+		last = now;
+		bytes += c.length;
+	});
+	await new Promise((resolve) => {
+		const tick = setInterval(() => {
+			if (last > 0 && performance.now() - t0 - last > 300) {
+				clearInterval(tick);
+				resolve();
+			}
+			if (performance.now() - t0 > 8000) {
+				clearInterval(tick);
+				resolve();
+			}
+		}, 20);
+	});
+	child.kill("SIGKILL");
+	await new Promise((r) => child.on("exit", r));
+	return { first, settled: last, bytes };
+}
+
+await once();
+const rs = [];
+for (let i = 0; i < runs; i++) rs.push(await once());
+console.log(JSON.stringify({ label: arg("label", prefix), runs, firstByteMs: Math.round(median(rs.map((r) => r.first))), settledMs: Math.round(median(rs.map((r) => r.settled))), bytes: rs[0].bytes }, null, 2));
diff --git a/bench/mock-server.mjs b/bench/mock-server.mjs
new file mode 100644
index 0000000..0d0c6b1
--- /dev/null
+++ b/bench/mock-server.mjs
@@ -0,0 +1,39 @@
+// Minimal OpenAI-compatible chat-completions server that records every request body.
+// Turn 1 answers with a `bash` tool call, turn 2 with `read`, turn 3 with plain text.
+import { appendFileSync, writeFileSync } from "node:fs";
+import { createServer } from "node:http";
+
+export function startMockServer({ logFile, port = 0, toolOutputTurns = 2 }) {
+	writeFileSync(logFile, "");
+	let turn = 0;
+	const server = createServer((req, res) => {
+		let body = "";
+		req.on("data", (c) => (body += c));
+		req.on("end", () => {
+			if (req.method !== "POST" || !req.url.includes("/chat/completions")) {
+				res.writeHead(404).end();
+				return;
+			}
+			appendFileSync(logFile, `${JSON.stringify({ t: Date.now(), url: req.url, bytes: Buffer.byteLength(body), body: JSON.parse(body) })}\n`);
+			turn++;
+			res.writeHead(200, { "content-type": "text/event-stream" });
+			const send = (delta, finish) =>
+				res.write(`data: ${JSON.stringify({ id: "x", object: "chat.completion.chunk", created: 1, model: "m", choices: [{ index: 0, delta, finish_reason: finish ?? null }] })}\n\n`);
+			if (turn <= toolOutputTurns) {
+				const call =
+					turn === 1
+						? { name: "bash", arguments: JSON.stringify({ command: "seq 1 4000" }) }
+						: { name: "read", arguments: JSON.stringify({ path: "package.json" }) };
+				send({ role: "assistant", tool_calls: [{ index: 0, id: `call_${turn}`, type: "function", function: call }] });
+				send({}, "tool_calls");
+			} else {
+				send({ role: "assistant", content: "done" });
+				send({}, "stop");
+			}
+			res.write(`data: ${JSON.stringify({ id: "x", object: "chat.completion.chunk", created: 1, model: "m", choices: [], usage: { prompt_tokens: 100, completion_tokens: 5, total_tokens: 105 } })}\n\n`);
+			res.write("data: [DONE]\n\n");
+			res.end();
+		});
+	});
+	return new Promise((resolve) => server.listen(port, "127.0.0.1", () => resolve({ server, port: server.address().port })));
+}
diff --git a/bench/run.mjs b/bench/run.mjs
new file mode 100644
index 0000000..f234b25
--- /dev/null
+++ b/bench/run.mjs
@@ -0,0 +1,151 @@
+#!/usr/bin/env node
+// Benchmark one build of the CLI against the local mock provider.
+//   node bench/run.mjs --cli <path/to/cli.js> --prefix SO|PI [--runs 15] [--json out.json] [--label name]
+// Measures: wall time to the first provider request (cold start to first byte on the wire), total print-mode run,
+// peak RSS of the process tree, request payload size per turn (system prompt, tool schema, messages).
+import { spawn } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { startMockServer } from "./mock-server.mjs";
+
+const cpuPreload = fileURLToPath(new URL("./cpu-preload.mjs", import.meta.url));
+
+const arg = (n, d) => {
+	const i = process.argv.indexOf(`--${n}`);
+	return i >= 0 ? process.argv[i + 1] : d;
+};
+const cli = arg("cli");
+const prefix = arg("prefix", "SO");
+const runs = Number(arg("runs", "15"));
+const label = arg("label", prefix);
+
+const home = mkdtempSync(join(tmpdir(), "bench-home-"));
+const agentDir = join(home, "agent");
+const project = mkdtempSync(join(tmpdir(), "bench-proj-"));
+mkdirSync(agentDir, { recursive: true });
+writeFileSync(join(project, "package.json"), JSON.stringify({ name: "bench", version: "1.0.0", description: "x".repeat(200) }, null, 2));
+
+const logFile = join(home, "requests.jsonl");
+const { server, port } = await startMockServer({ logFile });
+writeFileSync(
+	join(agentDir, "models.json"),
+	JSON.stringify({
+		providers: { mock: { baseUrl: `http://127.0.0.1:${port}/v1`, api: "openai-completions", apiKey: "k", models: [{ id: "m", contextWindow: 200000, maxTokens: 4096 }] } },
+	}),
+);
+
+function median(a) {
+	const s = [...a].sort((x, y) => x - y);
+	return s[Math.floor(s.length / 2)];
+}
+function readRss(pid) {
+	try {
+		const m = /VmHWM:\s+(\d+) kB/.exec(readFileSync(`/proc/${pid}/status`, "utf8"));
+		return m ? Number(m[1]) / 1024 : 0;
+	} catch {
+		return 0;
+	}
+}
+
+async function once() {
+	writeFileSync(logFile, "");
+	// reset turn counter by restarting the server state: a fresh server per run is simplest
+	const srv = await startMockServer({ logFile });
+	writeFileSync(
+		join(agentDir, "models.json"),
+		JSON.stringify({ providers: { mock: { baseUrl: `http://127.0.0.1:${srv.port}/v1`, api: "openai-completions", apiKey: "k", models: [{ id: "m", contextWindow: 200000, maxTokens: 4096 }] } } }),
+	);
+	const env = {
+		PATH: process.env.PATH,
+		HOME: home,
+		TMPDIR: tmpdir(),
+		[`${prefix}_CODING_AGENT_DIR`]: agentDir,
+		[`${prefix}_OFFLINE`]: "1",
+		[`${prefix}_SKIP_VERSION_CHECK`]: "1",
+		[`${prefix}_TELEMETRY`]: "0",
+		BENCH_CPU_FILE: join(home, "cpu.txt"),
+		...JSON.parse(process.env.BENCH_EXTRA_ENV ?? "{}"),
+	};
+	writeFileSync(env.BENCH_CPU_FILE, "");
+	const t0 = performance.now();
+	const child = spawn(process.execPath, ["--import", cpuPreload, ...(process.env.BENCH_NODE_ARGS ?? "").split(" ").filter(Boolean), cli, "-p", "--provider", "mock", "--model", "m", "--no-session", "--no-extensions", "run the commands", "--mode", "text"], { cwd: project, env, stdio: ["ignore", "pipe", "pipe"] });
+	let peak = 0;
+	const poll = setInterval(() => (peak = Math.max(peak, readRss(child.pid))), 20);
+	let firstReq;
+	const watch = setInterval(() => {
+		if (firstReq === undefined) {
+			try {
+				const l = readFileSync(logFile, "utf8").split("\n").filter(Boolean);
+				if (l.length) firstReq = performance.now() - t0;
+			} catch {}
+		}
+	}, 2);
+	let out = "";
+	child.stdout.on("data", (c) => (out += c));
+	child.stderr.on("data", (c) => (out += c));
+	const code = await new Promise((r) => child.on("exit", r));
+	clearInterval(poll);
+	clearInterval(watch);
+	const total = performance.now() - t0;
+	srv.server.close();
+	const reqs = readFileSync(logFile, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l));
+	const cpu = readFileSync(env.BENCH_CPU_FILE, "utf8").split("\n").filter(Boolean).map(Number).reduce((a, b) => a + b, 0);
+	return { code, out, firstReq, total, peak, reqs, cpu };
+}
+
+server.close();
+const results = [];
+await once(); // warmup (page cache)
+for (let i = 0; i < runs; i++) results.push(await once());
+const ok = results.filter((r) => r.code === 0 && r.reqs.length >= 3);
+if (ok.length === 0) {
+	console.error("no successful runs", results[0]?.code, results[0]?.out.slice(0, 2000));
+	process.exit(1);
+}
+const first = ok[0].reqs;
+const turn = (r) => {
+	const b = r.body;
+	const sys = (b.messages.find((m) => m.role === "system" || m.role === "developer")?.content) ?? "";
+	const sysText = typeof sys === "string" ? sys : JSON.stringify(sys);
+	return {
+		requestBytes: r.bytes,
+		systemPromptChars: sysText.length,
+		toolSchemaChars: JSON.stringify(b.tools ?? []).length,
+		toolCount: (b.tools ?? []).length,
+		messageChars: JSON.stringify(b.messages.filter((m) => m.role !== "system" && m.role !== "developer")).length,
+	};
+};
+// Prompt-cache friendliness: every request must start with the previous request's tools, system prompt and messages,
+// byte for byte, so providers can reuse the cached prefix. Reports the first turn that breaks the prefix, or null.
+function firstPrefixBreak(reqs) {
+	for (let i = 1; i < reqs.length; i++) {
+		const prev = reqs[i - 1].body;
+		const cur = reqs[i].body;
+		const strip = (b) => JSON.stringify({ ...b, messages: undefined, stream_options: undefined });
+		if (strip(prev) !== strip(cur)) return { turn: i + 1, why: "request parameters or tools changed" };
+		for (let m = 0; m < prev.messages.length; m++) {
+			if (JSON.stringify(prev.messages[m]) !== JSON.stringify(cur.messages[m])) return { turn: i + 1, why: `message ${m} changed` };
+		}
+	}
+	return null;
+}
+if (process.env.BENCH_SHOW_OUTPUT) console.error(ok[0].out);
+const summary = {
+	label,
+	runs: ok.length,
+	firstRequestMs: { median: Math.round(median(ok.map((r) => r.firstReq))), min: Math.round(Math.min(...ok.map((r) => r.firstReq))) },
+	totalMs: { median: Math.round(median(ok.map((r) => r.total))) },
+	cpuMs: { median: Math.round(median(ok.map((r) => r.cpu))) },
+	peakRssMiB: Math.round(median(ok.map((r) => r.peak))),
+	turns: first.map(turn),
+	promptPrefixBreak: firstPrefixBreak(first),
+};
+console.log(JSON.stringify(summary, null, 2));
+const jf = arg("json");
+if (jf) {
+	writeFileSync(jf, JSON.stringify(summary, null, 2));
+	writeFileSync(jf.replace(/\.json$/, ".request1.json"), JSON.stringify(first[0].body, null, 2));
+	writeFileSync(jf.replace(/\.json$/, ".request3.json"), JSON.stringify(first[2].body, null, 2));
+}
diff --git a/docs/EFFICIENCY.md b/docs/EFFICIENCY.md
new file mode 100644
index 0000000..13027b1
--- /dev/null
+++ b/docs/EFFICIENCY.md
@@ -0,0 +1,121 @@
+# Efficiency work and fork changes
+
+This is the honest account of what the fork changed beyond renaming, what was tried and reverted, and what was measured.
+The first pass of this work traded capability for speed (a shorter system prompt, shorter tool descriptions, network
+features switched off, files deleted). That was the wrong trade and most of it was reverted. The rule now: nothing that
+removes functionality, model guidance, docs or user-facing behavior stays unless it is purely the rename or fixes a
+fork-specific problem (the fix is then described below).
+
+Reproduce every number with `bench/` (see `bench/README.md`). Upstream baseline: Pi 1.4.0 at `6c384aa`, built unchanged.
+Machine: 8 vCPU Linux box, Node 22.23.4, mock OpenAI-compatible provider on localhost, medians of 31 cold runs after one
+warm-up, two interleaved rounds.
+
+## Results
+
+| Metric | Upstream Pi 1.4.0 | so agent | Reading |
+|---|---|---|---|
+| `--version` | 171.5 ms | 23.5 ms | Floor: `node -e 0` is 20.7 ms. The launcher answers without loading the application. |
+| Print mode, process start to first provider request | 234 / 238 ms | 235 / 238 ms | No change. Startup is about 150 ms of module evaluation and compile, 34 ms of `main()`, and 20 ms of Node itself. |
+| Print mode, whole 3-turn run | 315 / 319 ms | 315 / 318 ms | No change. |
+| Print mode, CPU time (user + system) | 396 / 401 ms | 393 / 400 ms | No change. |
+| Print mode, peak RSS | 122 MiB | 117 MiB | -5 MiB (-4%): the interactive UI module graph is no longer evaluated in print and RPC runs. |
+| Interactive TUI, first byte / screen settled | 219 / 357 ms and 212 / 350 ms | 219 / 358 ms and 224 / 363 ms | No change. |
+| System prompt, tool schemas, tool descriptions | 2682 chars, 2841 chars | same text, with the names changed (2655 chars) | Not touched. |
+| Request prefix stability across turns | n/a | stable | Every request starts with the previous request's tools, system prompt and messages byte for byte (`promptPrefixBreak: null`), so provider prompt caches work. Upstream's request has the same property. |
+| npm tarball | 7.70 MB packed, 23.7 MB unpacked | 7.71 MB, 23.7 MB | Unchanged (the first pass shrank it by dropping sourcemaps and images; reverted). |
+
+What limits these numbers. Wall time and CPU are dominated by evaluating and compiling the bundled module graph at start
+(the compile cache already saves about 58 ms; the cpu profile shows the time spread flat over the model catalog, the
+schema library, undici, the TUI and markdown libraries, with no single module above about 25 ms). Lazy mode loading
+therefore moves work around without removing it: print mode skips the interactive graph, which shows up as memory, not
+time. The only large win is the one that skips the application entirely (`--version`).
+
+The honest conclusion: upstream was already tuned (lazy chunks, compile cache, graph budgets enforced by
+`npm run check`, section-patch system prompts, truncated tool output with notes, provider cache markers). The lossless
+headroom that remains at startup is single-digit milliseconds per item. I measured and dropped these:
+
+- Deferring highlight.js language registration (12 ms of CPU in the profile): no measurable change in interactive
+  start (357/350 vs 358/363 ms), so it was not kept.
+- Lazy interactive-mode import in the interactive path: neutral.
+
+## Real-model eval (so 0.0.2 vs the upstream baseline)
+
+Local Qwen3-4B-Instruct-2507 (Q4_K_M) through llama.cpp, same prompts and tasks for both builds, 3 runs per task, `--max-tokens 1024`. Raw results are in `bench/eval/results/`, merged with `bench/eval/summarize.mjs`.
+
+| Task | Upstream | so |
+|---|---|---|
+| fix-off-by-one | 2/3 | 1/3 |
+| add-function | 0/3 | 0/3 |
+| count-todos | 0/3 | 0/3 |
+| create-config | 3/3 | 3/3 |
+| create-fizzbuzz | 3/3 | 3/3 |
+| change-default-port | 3/3 | 3/3 |
+| edit-package-json | 0/3 | 2/3 |
+| count-errors-large-log | 0 valid | 0 valid |
+| **Total** | 11/21 | 12/21 |
+
+Turns: so 88, upstream 61. Wall time: so 1596 s, upstream 935 s. Both are most likely sampling noise (the two builds send the same prompt apart from the name) but this was not verified with more runs.
+
+Caveats: n is tiny; a 4B model is weak and sampling is stochastic; some runs were invalid (a llama.cpp OOM kill) and are excluded; the large-log task exceeds the 20k context used, so it has no valid run; `--max-tokens 1024` truncates the model's many parallel tool calls identically for both builds. Treat this as a regression check (so is not worse by a margin visible at this n), not as an improvement claim. A hosted-model run with more tasks and runs is the next useful measurement.
+
+An earlier attempt through a free anonymous gateway produced the inconclusive file `bench/eval/results/pollinations-gpt-oss-20b-inconclusive.json`; that gateway sent tool-call arguments under a wrong index, which led to the 0.0.2 client fix, and returned frequent 5xx errors.
+
+## Kept changes (all lossless)
+
+| Change | Where | Evidence |
+|---|---|---|
+| `so --version` / `-v` answers from the launcher | `scripts/build-coding-agent-bundle.mjs` | 171.5 -> 23.5 ms. Only when it is the sole argument and `SO_PACKAGE_DIR` is not set; everything else takes the normal path. `scripts/cli-launcher.test.mjs` checks the output equals the full path's output and that other invocations load the runtime. |
