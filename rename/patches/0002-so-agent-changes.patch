diff --git a/scripts/cli-launcher.test.mjs b/scripts/cli-launcher.test.mjs
new file mode 100644
index 0000000..e4f1f54
--- /dev/null
+++ b/scripts/cli-launcher.test.mjs
@@ -0,0 +1,103 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const launcher = join(root, "packages", "coding-agent", "dist", "bundle", "cli.js");
+const built = existsSync(launcher);
+
+// Preload that reports when the launcher loads the application graph.
+const dir = mkdtempSync(join(tmpdir(), "so-launcher-"));
+const preload = join(dir, "preload.cjs");
+writeFileSync(
+	preload,
+	`const M = require("node:module"); const orig = M.prototype.require;
+M.prototype.require = function (id) { if (String(id).endsWith("cli-runtime.js")) process.stderr.write("LOADED_RUNTIME\\n"); return orig.apply(this, arguments); };`,
+);
+
+function run(args) {
+	return spawnSync(process.execPath, ["--require", preload, launcher, ...args], {
+		encoding: "utf8",
+		env: { ...process.env, SO_OFFLINE: "1", SO_CODING_AGENT_DIR: join(dir, "agent") },
+	});
+}
+
+test("so --version and -v print the package version without loading the application", { skip: !built }, () => {
+	const version = JSON.parse(readFileSync(join(root, "packages", "coding-agent", "package.json"), "utf8")).version;
+	for (const flag of ["--version", "-v"]) {
+		const result = run([flag]);
+		assert.equal(result.status, 0, result.stderr);
+		assert.equal(result.stdout.trim(), version);
+		assert.ok(!result.stderr.includes("LOADED_RUNTIME"), `${flag} must not load the runtime`);
+	}
+});
+
+test("other invocations still load the application", { skip: !built }, () => {
+	const result = run(["--help"]);
+	assert.equal(result.status, 0, result.stderr);
+	assert.ok(result.stderr.includes("LOADED_RUNTIME"));
+	assert.match(result.stdout, /Usage:/);
+	// `--version` combined with other arguments takes the normal path
+	assert.ok(run(["--version", "--offline"]).stderr.includes("LOADED_RUNTIME"));
+});
+
+test("the fast path prints exactly what the full path prints, and SO_PACKAGE_DIR forces the full path", { skip: !built }, () => {
+	const fast = run(["--version"]);
+	const packageDir = join(root, "packages", "coding-agent");
+	const full = spawnSync(process.execPath, ["--require", preload, launcher, "--version"], {
+		encoding: "utf8",
+		env: { ...process.env, SO_OFFLINE: "1", SO_CODING_AGENT_DIR: join(dir, "agent"), SO_PACKAGE_DIR: packageDir },
+	});
+	assert.equal(full.status, 0, full.stderr);
+	assert.ok(full.stderr.includes("LOADED_RUNTIME"));
+	assert.equal(full.stdout, fast.stdout);
+});
+
+test("print mode never loads the interactive UI module graph", { skip: !built }, async () => {
+	const { startMockServer } = await import("../bench/mock-server.mjs");
+	const { spawn } = await import("node:child_process");
+	const log = join(dir, "loaded.txt");
+	writeFileSync(log, "");
+	const hooks = join(dir, "hooks.cjs");
+	writeFileSync(
+		hooks,
+		`const { registerHooks } = require("node:module"); const { appendFileSync } = require("node:fs");
+registerHooks({ resolve(s, c, next) { const r = next(s, c); if (r.url.includes("/chunks/")) appendFileSync(${JSON.stringify(log)}, r.url + "\\n"); return r; } });`,
+	);
+	const agentDir = join(dir, "print-agent");
+	const project = mkdtempSync(join(dir, "proj-"));
+	const { server, port } = await startMockServer({ logFile: join(dir, "requests.jsonl"), toolOutputTurns: 0 });
+	try {
+		mkdirSync(agentDir, { recursive: true });
+		writeFileSync(
+			join(agentDir, "models.json"),
+			JSON.stringify({
+				providers: { mock: { baseUrl: `http://127.0.0.1:${port}/v1`, api: "openai-completions", apiKey: "k", models: [{ id: "m", contextWindow: 100000, maxTokens: 1000 }] } },
+			}),
+		);
+		const child = spawn(process.execPath, ["--require", hooks, launcher, "-p", "--provider", "mock", "--model", "m", "--no-session", "--no-extensions", "hi"], {
+			cwd: project,
+			env: { ...process.env, SO_OFFLINE: "1", SO_CODING_AGENT_DIR: agentDir },
+			stdio: ["ignore", "pipe", "pipe"],
+		});
+		let output = "";
+		child.stdout.on("data", (c) => (output += c));
+		child.stderr.on("data", (c) => (output += c));
+		const code = await new Promise((resolveExit) => child.on("exit", resolveExit));
+		assert.equal(code, 0, output);
+		assert.match(output, /done/);
+		const loaded = [...new Set(readFileSync(log, "utf8").split("\n").filter(Boolean))];
+		assert.ok(loaded.length > 0, "the hook recorded no chunk loads");
+		// The interactive mode is its own chunk (`interactive-mode-<hash>.js`), reached only through a dynamic import.
+		const chunkDir = join(root, "packages", "coding-agent", "dist", "bundle", "chunks");
+		assert.ok(readdirSync(chunkDir).some((name) => /^interactive-mode-.*\.js$/.test(name)), "no interactive mode chunk was built");
+		const interactive = loaded.filter((url) => /\/interactive-mode-[^/]*\.js$/.test(url));
+		assert.deepEqual(interactive, [], "print mode evaluated the interactive mode module");
+	} finally {
+		server.close();
+	}
+});
diff --git a/scripts/eval-tasks.test.mjs b/scripts/eval-tasks.test.mjs
new file mode 100644
index 0000000..e6a8839
--- /dev/null
+++ b/scripts/eval-tasks.test.mjs
@@ -0,0 +1,35 @@
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import test from "node:test";
+import { tasks } from "../bench/eval/tasks.mjs";
+
+function setup(files) {
+	const dir = mkdtempSync(join(tmpdir(), "eval-task-"));
+	for (const [f, c] of Object.entries(files)) {
+		mkdirSync(dirname(join(dir, f)), { recursive: true });
+		writeFileSync(join(dir, f), c);
+	}
+	return dir;
+}
+
+for (const task of tasks) {
+	test(`eval task ${task.id}: check fails on the starting state and passes on the reference solution`, () => {
+		const dir = setup(task.files);
+		try {
+			assert.equal(Boolean(task.check(dir)), false, "starting state must not pass");
+			for (const [f, c] of Object.entries(task.solution)) {
+				mkdirSync(dirname(join(dir, f)), { recursive: true });
+				writeFileSync(join(dir, f), c);
+			}
+			assert.equal(Boolean(task.check(dir)), true, "reference solution must pass");
+		} finally {
+			rmSync(dir, { recursive: true, force: true });
+		}
+	});
+}
+
+test("eval task ids are unique", () => {
+	assert.equal(new Set(tasks.map((t) => t.id)).size, tasks.length);
+});
diff --git a/scripts/npm-claim-scope.sh b/scripts/npm-claim-scope.sh
new file mode 100755
index 0000000..df4ff03
--- /dev/null
+++ b/scripts/npm-claim-scope.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# Reserve the @so-agent npm scope names with inert placeholder packages (version 0.0.0, dist-tag "placeholder").
+#
+# The scope itself is held by the npm user or organization called "so-agent": create that first (free, public
+# packages only) at https://www.npmjs.com/org/create. Publishing placeholders is optional on top of that; it
+# also reserves the individual package names. Placeholders use 0.0.0 on purpose: the first real release is 0.0.1
+# and a published version number can never be reused.
+#
+#   scripts/npm-claim-scope.sh              dry run: checks login/scope, builds the placeholders, publishes nothing
+#   scripts/npm-claim-scope.sh --publish    publishes them (npm asks for your 2FA code when needed)
+set -euo pipefail
+
+SCOPE="@so-agent"
+NAMES=(agent-core ai chord codemode coding-agent durable env evals mcp telemetry tui)
+REPO_URL="git+https://github.com/kevin9327/so-agent.git"   # placeholder repo URL, change when the repo exists
+mode="dry-run"; [ "${1:-}" = "--publish" ] && mode="publish"
+
+user="$(npm whoami 2>/dev/null || true)"
+if [ -z "$user" ]; then
+  echo "Not logged in to npm. Run 'npm login' (account with 2FA enabled), then run this script again." >&2
+  exit 1
+fi
+echo "npm user: $user"
+
+if npm org ls "${SCOPE#@}" "$user" >/dev/null 2>&1 || [ "$user" = "${SCOPE#@}" ]; then
+  echo "Scope $SCOPE: you are a member/owner."
+else
+  echo "Scope $SCOPE: this account is not a member of an org or user named '${SCOPE#@}'." >&2
+  echo "Create the org first: https://www.npmjs.com/org/create (name: ${SCOPE#@}, free plan, public packages)." >&2
+  [ "$mode" = "publish" ] && exit 1
+fi
+
+work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
+for n in "${NAMES[@]}"; do
+  d="$work/$n"; mkdir -p "$d"
+  cat >"$d/package.json" <<JSON
+{
+  "name": "$SCOPE/$n",
+  "version": "0.0.0",
+  "description": "Name reservation for so agent. The first real release is 0.0.1.",
+  "license": "MIT",
+  "repository": { "type": "git", "url": "$REPO_URL" },
+  "publishConfig": { "access": "public", "tag": "placeholder" }
+}
+JSON
+  printf '# %s/%s\n\nName reservation for so agent. Not a release.\n' "$SCOPE" "$n" >"$d/README.md"
+  if [ "$mode" = "publish" ]; then
+    (cd "$d" && npm publish --access public --tag placeholder)
+  else
+    (cd "$d" && npm publish --dry-run --access public --tag placeholder 2>&1 | tail -n 3)
+  fi
+done
+echo "Done ($mode)."
diff --git a/scripts/rename-codemod.test.mjs b/scripts/rename-codemod.test.mjs
new file mode 100644
index 0000000..a5f5b8f
--- /dev/null
+++ b/scripts/rename-codemod.test.mjs
@@ -0,0 +1,76 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+import { expandLegacyAliasLines, transform } from "../rename/rename.mjs";
+
+const codemod = join(dirname(fileURLToPath(import.meta.url)), "..", "rename", "rename.mjs");
+
+test("transform renames the brand but not unrelated words", () => {
+	assert.equal(transform("PI_OFFLINE pipe api pixel Math.PI .pi/skills"), "SO_OFFLINE pipe api pixel Math.PI .so/skills");
+	assert.equal(transform('import "@earendil-works/pi-ai/compat"'), 'import "@so-agent/ai/compat"');
+	// Third-party packages published under the same scope are not Pi packages and must keep their names.
+	assert.equal(
+		transform('import { VM } from "@earendil-works/gondolin"; "@earendil-works/gondolin-krun-runner-linux-x64"'),
+		'import { VM } from "@earendil-works/gondolin"; "@earendil-works/gondolin-krun-runner-linux-x64"',
+	);
+	assert.equal(transform("see https://pi.dev/docs and earendil-works/pi"), "see https://pi.dev/docs and earendil-works/pi");
+});
+
+const LOADER = [
+	'const piTuiEntry = resolveWorkspaceOrImport("tui/dist/index.js", "@earendil-works/pi-tui");',
+	"const aliases = {",
+	'\t"@earendil-works/pi-tui": piTuiEntry,',
+	'\t"@mariozechner/pi-tui": piTuiEntry,',
+	"};",
+].join("\n");
+
+test("alias tables keep resolving Pi's package names next to the renamed ones", () => {
+	const file = "packages/coding-agent/src/core/extensions/loader.ts";
+	const out = expandLegacyAliasLines(LOADER, transform(LOADER), file);
+	const lines = out.split("\n");
+	// The module actually imported is renamed; both Pi scopes stay as keys that point at the renamed entry.
+	assert.ok(lines.includes('const soTuiEntry = resolveWorkspaceOrImport("tui/dist/index.js", "@so-agent/tui");'));
+	assert.ok(lines.includes('\t"@so-agent/tui": soTuiEntry,'));
+	assert.ok(lines.includes('\t"@earendil-works/pi-tui": soTuiEntry,'));
+	assert.ok(lines.includes('\t"@mariozechner/pi-tui": soTuiEntry,'));
+	// Running the expansion over its own output changes nothing.
+	assert.equal(expandLegacyAliasLines(out, transform(out), file), out);
+});
+
+test("the codemod deletes nothing, disables upstream governance workflows by renaming them, and is idempotent", () => {
+	const root = mkdtempSync(join(tmpdir(), "rename-codemod-"));
+	try {
+		const files = {
+			".github/workflows/issue-gate.yml": "name: pi issue gate\n",
+			".github/workflows/ci.yml": "name: pi ci\n",
+			"scripts/issues/main.ts": "export const tool = 'pi';\n",
+			"packages/coding-agent/src/core/extensions/loader.ts": LOADER,
+			"LICENSE": "Copyright pi authors\n",
+		};
+		for (const [path, text] of Object.entries(files)) {
+			mkdirSync(dirname(join(root, path)), { recursive: true });
+			writeFileSync(join(root, path), text);
+		}
+		const git = (...args) => execFileSync("git", args, { cwd: root, encoding: "utf8" });
+		git("init", "-q");
+		git("add", "-A");
+		execFileSync(process.execPath, [codemod, "--root", root], { stdio: "ignore" });
+		git("add", "-A");
+		assert.equal(readFileSync(join(root, ".github/workflows/issue-gate.yml.disabled"), "utf8"), "name: so issue gate\n");
+		assert.ok(!existsSync(join(root, ".github/workflows/issue-gate.yml")));
+		assert.equal(readFileSync(join(root, ".github/workflows/ci.yml"), "utf8"), "name: so ci\n");
+		assert.ok(existsSync(join(root, "scripts/issues/main.ts")));
+		assert.equal(readFileSync(join(root, "LICENSE"), "utf8"), files.LICENSE);
+		const once = git("ls-files", "-s") + readFileSync(join(root, "packages/coding-agent/src/core/extensions/loader.ts"), "utf8");
+		execFileSync(process.execPath, [codemod, "--root", root], { stdio: "ignore" });
+		git("add", "-A");
+		const twice = git("ls-files", "-s") + readFileSync(join(root, "packages/coding-agent/src/core/extensions/loader.ts"), "utf8");
+		assert.equal(twice, once);
+	} finally {
+		rmSync(root, { recursive: true, force: true });
+	}
+});
diff --git a/scripts/throttle-proxy.test.mjs b/scripts/throttle-proxy.test.mjs
new file mode 100644
index 0000000..2729ade
--- /dev/null
+++ b/scripts/throttle-proxy.test.mjs
@@ -0,0 +1,71 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+
+const proxyScript = fileURLToPath(new URL("../bench/eval/throttle-proxy.mjs", import.meta.url));
+
+test("throttle proxy spaces calls, waits out a rate-limit answer and forwards the body unchanged", async () => {
+	const seen = [];
+	let calls = 0;
+	const upstream = createServer((req, res) => {
+		let body = "";
+		req.on("data", (c) => (body += c));
+		req.on("end", () => {
+			calls++;
+			seen.push({ at: Date.now(), url: req.url, body, ua: req.headers["user-agent"] });
+			if (calls === 1) {
+				res.writeHead(402, { "content-type": "application/json" }).end('{"error":{"message":"Free limit reached. Retry after 1s"}}');
+				return;
+			}
+			res.writeHead(200, { "content-type": "text/event-stream" }).end("data: [DONE]\n\n");
+		});
+	});
+	upstream.listen(0, "127.0.0.1");
+	await once(upstream, "listening");
+	const upstreamPort = upstream.address().port;
+
+	const proxyPort = 20000 + Math.floor(Math.random() * 20000);
+	const proxy = spawn(process.execPath, [proxyScript, "--upstream", `http://127.0.0.1:${upstreamPort}/openai`, "--port", String(proxyPort), "--min-interval-ms", "300"], { stdio: ["ignore", "ignore", "pipe"] });
+	try {
+		for await (const chunk of proxy.stderr) if (String(chunk).includes("one call per")) break;
+		const payload = JSON.stringify({ model: "m", messages: [{ role: "user", content: "hi" }] });
+		const res = await fetch(`http://127.0.0.1:${proxyPort}/v1/chat/completions`, { method: "POST", body: payload, headers: { "content-type": "application/json" } });
+		assert.equal(res.status, 200);
+		assert.match(await res.text(), /\[DONE\]/);
+		assert.equal(seen.length, 2, "one rate-limited attempt, one retry");
+		assert.equal(seen[0].url, "/openai/chat/completions");
+		assert.equal(seen[1].body, payload, "body is forwarded byte for byte on the retry");
+		assert.match(seen[0].ua, /^so-agent-eval\//);
+		assert.ok(seen[1].at - seen[0].at >= 1500, "waits for the advertised retry time");
+	} finally {
+		proxy.kill();
+		upstream.close();
+	}
+});
+
+test("repairStream moves a nameless continuation chunk back to the open tool call and leaves normal streams alone", async () => {
+	const { repairStream } = await import("../bench/eval/repair-stream.mjs");
+	const chunk = (tool_calls, extra = {}) => `data: ${JSON.stringify({ choices: [{ index: 0, delta: { tool_calls }, ...extra }] })}\n\n`;
+	const broken = [
+		chunk([{ index: 0, id: "c1", type: "function", function: { name: "read", arguments: "" } }]),
+		chunk([{ index: 0, function: { arguments: '{"path":"a.js","limit":' } }]),
+		chunk([{ index: 1, function: { arguments: "200}" } }], { finish_reason: "tool_calls" }),
+		"data: [DONE]\n\n",
+	].join("");
+	const repair = repairStream();
+	// feed in arbitrary slices: chunk boundaries must not matter
+	let out = "";
+	for (let i = 0; i < broken.length; i += 37) out += repair(broken.slice(i, i + 37));
+	out += repair("", true);
+	const indexes = out.split("\n").filter((l) => l.startsWith("data: {")).map((l) => JSON.parse(l.slice(6)).choices[0].delta.tool_calls[0].index);
+	assert.deepEqual(indexes, [0, 0, 0]);
+	assert.match(out, /data: \[DONE\]/);
+
+	// two genuine parallel calls (second has id and name) are untouched
+	const parallel = [chunk([{ index: 0, id: "a", function: { name: "read", arguments: "{}" } }]), chunk([{ index: 1, id: "b", function: { name: "bash", arguments: "{}" } }])].join("");
+	const r2 = repairStream();
+	assert.equal(r2(parallel) + r2("", true), parallel + "\n");
+});
