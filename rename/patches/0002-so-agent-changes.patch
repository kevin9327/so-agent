+		prompt: "app.log is a large log file. Count the lines that contain the level ERROR (as a whole word, uppercase) and write only the number to answer.txt.",
+		files: {
+			"app.log": Array.from({ length: 3000 }, (_, i) => `2026-10-27T10:${String(Math.floor(i / 60) % 60).padStart(2, "0")}:${String(i % 60).padStart(2, "0")} ${i % 176 === 5 ? "ERROR" : i % 97 === 0 ? "WARN" : "INFO"} request ${i} handled${i % 500 === 7 ? " (no ERRORS here, just a word)" : ""}`).join("\n") + "\n",
+		},
+		check: (cwd) => read(cwd, "answer.txt").trim() === String(Array.from({ length: 3000 }, (_, i) => i).filter((i) => i % 176 === 5).length),
+	},
+];
diff --git a/bench/eval/throttle-proxy.mjs b/bench/eval/throttle-proxy.mjs
new file mode 100644
index 0000000..a2005b9
--- /dev/null
+++ b/bench/eval/throttle-proxy.mjs
@@ -0,0 +1,79 @@
+// Local pass-through for OpenAI-compatible endpoints with a hard per-IP rate limit (for example anonymous free tiers).
+// It spaces upstream calls by --min-interval-ms and, on a rate-limit answer before any bytes were streamed, waits and
+// retries, so the limit is respected instead of evaded. It never changes request bodies.
+//   node bench/eval/throttle-proxy.mjs --upstream https://host/openai --port 8787 --min-interval-ms 31000 [--log-errors errors.jsonl] [--log-all trace.jsonl] [--repair-tool-index]
+import { appendFileSync } from "node:fs";
+import { createServer } from "node:http";
+import { repairStream } from "./repair-stream.mjs";
+
+const arg = (n, d) => {
+	const i = process.argv.indexOf(`--${n}`);
+	return i >= 0 ? process.argv[i + 1] : d;
+};
+const upstream = arg("upstream");
+const port = Number(arg("port", "8787"));
+const minInterval = Number(arg("min-interval-ms", "31000"));
+const maxRetries = Number(arg("max-retries", "6"));
+const ua = arg("user-agent", "so-agent-eval/0.0.1");
+const traceLog = arg("log-all"); // optional file: request body and raw answer of every call (debugging provider glitches)
+const repairIndex = process.argv.includes("--repair-tool-index"); // see repairStream below
+const errorLog = arg("log-errors"); // optional file: request body and answer of every non-2xx final response (no headers, so no keys)
+if (!upstream) throw new Error("--upstream is required");
+
+let last = 0;
+let queue = Promise.resolve();
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const slot = () => {
+	const next = queue.then(async () => {
+		const wait = last + minInterval - Date.now();
+		if (wait > 0) await sleep(wait);
+		last = Date.now();
+	});
+	queue = next.catch(() => {});
+	return next;
+};
+
+export const stats = { forwarded: 0, retried: 0, failed: 0 };
+
+createServer(async (req, res) => {
+	const chunks = [];
+	for await (const c of req) chunks.push(c);
+	const body = Buffer.concat(chunks);
+	const url = upstream.replace(/\/$/, "") + req.url.replace(/^\/v1/, "");
+	for (let attempt = 0; attempt <= maxRetries; attempt++) {
+		await slot();
+		const r = await fetch(url, { method: req.method, headers: { "content-type": "application/json", "user-agent": ua, authorization: req.headers.authorization ?? "" }, body: req.method === "GET" ? undefined : body });
+		if ((r.status === 402 || r.status === 429) && attempt < maxRetries) {
+			const text = await r.text();
+			const m = /retry after (\d+)s/i.exec(text);
+			stats.retried++;
+			console.error(`[proxy] ${r.status} rate limited, waiting ${m ? m[1] : "?"}s (attempt ${attempt + 1})`);
+			await sleep((m ? Number(m[1]) : 30) * 1000 + 1000);
+			continue;
+		}
+		stats.forwarded++;
+		if (traceLog) {
+			const text = await r.text();
+			appendFileSync(traceLog, `${JSON.stringify({ at: new Date().toISOString(), status: r.status, request: body.toString("utf8"), response: text })}\n`);
+			res.writeHead(r.status, { "content-type": r.headers.get("content-type") ?? "application/json" }).end(text);
+			return;
+		}
+		if (errorLog && !r.ok) {
+			const text = await r.text();
+			appendFileSync(errorLog, `${JSON.stringify({ at: new Date().toISOString(), status: r.status, request: body.toString("utf8"), response: text })}\n`);
+			res.writeHead(r.status, { "content-type": r.headers.get("content-type") ?? "application/json" }).end(text);
+			return;
+		}
+		res.writeHead(r.status, { "content-type": r.headers.get("content-type") ?? "application/json" });
+		if (r.body) {
+			const repair = repairIndex ? repairStream() : undefined;
+			const decoder = new TextDecoder();
+			for await (const c of r.body) res.write(repair ? repair(decoder.decode(c, { stream: true })) : c);
+			if (repair) res.write(repair("", true));
+		}
+		res.end();
+		return;
+	}
+	stats.failed++;
+	res.writeHead(502).end("rate limit retries exhausted");
+}).listen(port, "127.0.0.1", () => console.error(`[proxy] 127.0.0.1:${port} -> ${upstream}, one call per ${minInterval} ms`));
diff --git a/bench/eval/transcript-to-md.mjs b/bench/eval/transcript-to-md.mjs
new file mode 100644
index 0000000..099ecbe
--- /dev/null
+++ b/bench/eval/transcript-to-md.mjs
@@ -0,0 +1,33 @@
+#!/usr/bin/env node
+// Render a --mode json transcript (see run-eval.mjs --transcripts) as readable markdown.
+//   node bench/eval/transcript-to-md.mjs transcript.jsonl "task prompt" > demo.md
+import { readFileSync } from "node:fs";
+
+const [file, prompt] = process.argv.slice(2);
+if (!file) throw new Error("usage: transcript-to-md.mjs <transcript.jsonl> [prompt]");
+const events = readFileSync(file, "utf8").split("\n").flatMap((l) => {
+	try {
+		return [JSON.parse(l)];
+	} catch {
+		return [];
+	}
+});
+const out = [];
+if (prompt) out.push(`**You:** ${prompt}`, "");
+const text = (content) => content.filter((b) => b.type === "text").map((b) => b.text).join("").trim();
+for (const e of events) {
+	if (e.type === "message_end" && e.message?.role === "assistant") {
+		const t = text(e.message.content);
+		if (t) out.push(`**so:** ${t}`, "");
+	}
+	if (e.type === "tool_execution_start") {
+		const args = e.args ?? {};
+		const summary = e.toolName === "bash" ? args.command : e.toolName === "write" ? `${args.path} (${String(args.content ?? "").length} chars)` : e.toolName === "edit" ? args.path : (args.path ?? JSON.stringify(args));
+		out.push(`\`${e.toolName}\` ${e.toolName === "bash" ? "`" + summary + "`" : summary}`, "");
+	}
+	if (e.type === "tool_execution_end") {
+		const t = text(e.result?.content ?? []);
+		out.push(`> ${e.isError ? "error: " : ""}${t.split("\n").slice(0, 6).join("\n> ").slice(0, 600)}`, "");
+	}
+}
+process.stdout.write(`${out.join("\n").trim()}\n`);
